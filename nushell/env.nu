const platform_module = path self | path expand | path dirname | path join "platform.nu"
use $platform_module [termux android-mise]
android-mise

$env.BAT_THEME = "ansi"
# Android does not opt into ov; use the native pager without a startup lookup.
$env.PAGER = if (termux) { "less -FRX" } else { "ov -F" }
if $env.EDITOR? == null { $env.EDITOR = "nvim" }
if $env.VISUAL? == null { $env.VISUAL = $env.EDITOR }

# Use the installed mise and user commands without changing device SSH settings.
if $nu.os-info.name in ["linux" "macos"] or (termux) {
    # tmux and Zellij use SHELL for new panes; leave the login shell unchanged.
    $env.SHELL = $nu.current-exe
    $env.PATH = ($env.PATH | prepend ($nu.home-dir | path join ".local" "bin") | uniq)
}

if $nu.os-info.name == "macos" {
    $env.GOPATH = ($nu.home-dir | path join "proj" "go")
    $env.FLYCTL_INSTALL = ($nu.home-dir | path join ".fly")
    let paths = [
        ($env.GOPATH | path join "bin")
        ($env.FLYCTL_INSTALL | path join "bin")
        "/Applications/Obsidian.app/Contents/MacOS"
        "/opt/homebrew/bin"
        "/opt/homebrew/sbin"
        "/usr/local/bin"
        "/usr/local/sbin"
    ] | where {|entry| $entry | path exists}
    $env.PATH = ($env.PATH | prepend $paths | uniq)
}

if (termux) {
    $env.LANG = ($env.LANG? | default "en_US.UTF-8")
    $env.LC_CTYPE = ($env.LC_CTYPE? | default "en_US.UTF-8")
    # Termux starts its runit services only from POSIX login profiles, and Nu is
    # the Termux shell, so start the supervisor (ssh-agent, sshd) here instead.
    let daemon = $env.PREFIX | path join "bin" "service-daemon"
    # PIDs are reused across reboots, so check that the recorded one is runsvdir.
    let running = try {
        let pid = open ($env.PREFIX | path join "var" "run" "service-daemon.pid") | str trim
        open --raw ("/proc" | path join $pid "cmdline") | str contains "runsvdir"
    } catch { false }
    if ($daemon | path exists) and not $running {
        # openssh upgrades reinstall the service's `down` file, which keeps the
        # agent from starting at boot, so drop it before runsvdir reads it.
        rm -f ($env.PREFIX | path join "var" "service" "ssh-agent" "down")
        with-env {SVDIR: ($env.PREFIX | path join "var" "service") LOGDIR: ($env.PREFIX | path join "var" "log")} {
            ^$daemon start out+err> /dev/null
        }
    }
    # Keep a live forwarded agent (SSH, or Herdr's link to its client's agent).
    # A dead link, such as Herdr's when its client had no agent, falls back to
    # the device agent. Never load keys here; run `ssh-add` once per agent start.
    if ($env.SSH_AUTH_SOCK? | default "" | path expand | path type) != "socket" {
        $env.SSH_AUTH_SOCK = $env.PREFIX | path join "var" "run" "ssh-agent.socket"
    }
}

# Keep mise-managed versions ahead of inherited copies (such as Pi's rg).
$env.MISE_ACTIVATE_AGGRESSIVE = "true"

# Generate mise's session-dependent code before config.nu imports it.
# Zoxide's static integration is generated by bootstrap.nu, not on every launch.
mkdir $nu.cache-dir
^mise activate nu | save --force ($nu.cache-dir | path join "mise.nu")

# Use the same device config on every platform; preserve explicit overrides.
$env.FNOX_CONFIG_DIR = ($env.FNOX_CONFIG_DIR? | default ($nu.home-dir | path join ".config" "fnox"))
# Hide secret-name notices, not resolution errors.
$env.FNOX_SHELL_OUTPUT = "none"
